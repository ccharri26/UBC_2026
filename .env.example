# Copy to .env and fill in. Never commit .env.

# --- Agent wallet (Base) ---
# Throwaway wallet holding ~$5 USDC. Its balance is the most the agent can lose.
WALLET_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org

# --- Nansen (x402, pay-per-call, no API key) ---
NANSEN_BASE_URL=https://api.nansen.ai

# --- Spending budgets in USD (the $0.05 per-call hard cap lives in code) ---
# Per market = one (asset, tier), e.g. ETH-smart_money, per UTC day.
BUDGET_PER_MARKET_USD=0.10
BUDGET_PER_RUN_USD=0.50
BUDGET_DAILY_USD=2.00

# --- Human approval ---
# The highest Approval Threshold the dashboard may set. Purchases at or above the
# threshold wait for a human (90 s; no answer = refused + kill switch on).
# Missing = 0: every purchase needs approval.
APPROVAL_CEILING_USD=0.06

# --- Safety switches ---
KILL_SWITCH=false
SHADOW_MODE=true

# --- Gemini (public market data needs no key; only for optional sandbox orders) ---
GEMINI_API_BASE_URL=https://api.gemini.com
GEMINI_SANDBOX_API_KEY=
GEMINI_SANDBOX_API_SECRET=

# true = fake Nansen signals, no network, no spending (for building/testing without a wallet)
NANSEN_STUB=false

# --- LLM (Grok via xAI's OpenAI-compatible API) ---
GROK_API_KEY=
# Check docs.x.ai for current model names.
GROK_MODEL=grok-4
# llm = Grok runs the agent cycle; rule = deterministic cycle.py (also the fallback)
AGENT_MODE=rule
