# Copy to .env and fill in. Never commit .env.

# --- Agent wallet (Base) ---
# Throwaway wallet holding ~$5 USDC. Its balance is the most the agent can lose.
WALLET_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org

# --- Nansen (x402, pay-per-call, no API key) ---
NANSEN_BASE_URL=https://api.nansen.ai

# --- Spending budgets in USD (the $0.05 per-call hard cap lives in code) ---
BUDGET_PER_MARKET_USD=0.10
BUDGET_PER_RUN_USD=0.50
BUDGET_DAILY_USD=2.00

# --- Safety switches ---
KILL_SWITCH=false
SHADOW_MODE=true

# --- Gemini (public market data needs no key; only for optional sandbox orders) ---
GEMINI_API_BASE_URL=https://api.gemini.com
GEMINI_SANDBOX_API_KEY=
GEMINI_SANDBOX_API_SECRET=
